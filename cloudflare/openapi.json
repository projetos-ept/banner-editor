{
  "openapi": "3.1.0",
  "info": {
    "title": "banerlab API",
    "version": "1.0.0",
    "description": "Cloudflare Workers + R2. API privada com token compartilhado por espaço de trabalho. JSON autocontido com imagens base64. Limite da implementação: 8 MiB por documento. Sem processamento de PDF no servidor. Campos opcionais de estilo são normalizados pelo mesmo BannerCore do editor."
  },
  "servers": [
    {
      "url": "http://localhost:8787/v1",
      "description": "Wrangler local"
    },
    {
      "url": "https://banerlab-api.SEU-SUBDOMINIO.workers.dev/v1",
      "description": "Substitua pela URL publicada"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Verificar processo HTTP (não testa R2)",
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Worker responde",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "service": {
                      "const": "banerlab"
                    },
                    "apiVersion": {
                      "const": 1
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Origem ou cabeçalho CORS não permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "options": {
        "summary": "Preflight CORS",
        "operationId": "preflightHealth",
        "security": [],
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Access-Control-Request-Method",
            "schema": {
              "type": "string",
              "enum": [
                "GET",
                "POST",
                "DELETE"
              ]
            }
          },
          {
            "in": "header",
            "name": "Access-Control-Request-Headers",
            "schema": {
              "type": "string",
              "example": "authorization,content-type"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Preflight aceito; cabeçalhos Allow-Origin, Allow-Methods e Allow-Headers."
          },
          "403": {
            "description": "Origem ou cabeçalho CORS não permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Método não permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
