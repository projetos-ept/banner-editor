      "get": {
        "summary": "Listar metadados em ordem lexicográfica de ID",
        "operationId": "listBanners",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string",
              "maxLength": 4096
            },
            "description": "Token opaco da resposta anterior. Continue até cursor ser null."
          }
        ],
        "responses": {
          "200": {
            "description": "Página de resultados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "cursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^(?!(__proto__|constructor|prototype)$)[A-Za-z0-9_-]{1,80}$"
                          },
                          "title": {
                            "type": "string"
                          },
                          "preset": {
                            "type": "string"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "size": {
                            "type": "integer",
                            "description": "Bytes armazenados"
                          }
                        }
                      }
                    },
                    "cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "JSON, ID ou query inválidos",
