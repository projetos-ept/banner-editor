  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Secret API_TOKEN do Worker, 32 a 512 caracteres. Não é o token da conta Cloudflare."
      }
    },
    "schemas": {
      "BannerInput": {
        "type": "object",
        "required": [
          "schema",
          "version",
          "id",
          "preset",
          "assets",
          "blocks"
        ],
        "properties": {
          "schema": {
            "type": "string",
            "enum": [
              "banerlab",
              "aquilombe-banner"
            ]
          },
          "version": {
            "type": "integer",
            "const": 2
          },
          "id": {
            "type": "string",
            "pattern": "^(?!(__proto__|constructor|prototype)$)[A-Za-z0-9_-]{1,80}$"
          },
          "title": {
            "type": "string",
            "description": "Título do projeto",
            "maxLength": 160
          },
          "preset": {
            "type": "string",
            "enum": [
              "60x90",
              "80x120",
              "90x120",
              "100x150"
            ]
          },
          "background": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[A-Fa-f0-9]{6}$"
              },
              "assetId": {
                "type": "string",
                "description": "Vazio ou chave existente em assets",
                "maxLength": 80
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "fit": {
                "type": "string",
                "enum": [
                  "contain",
                  "cover",
                  "fill"
                ]
              }
            }
          },
          "assets": {
            "type": "object",
            "maxProperties": 100,
            "propertyNames": {
              "type": "string",
              "pattern": "^(?!(__proto__|constructor|prototype)$)[A-Za-z0-9_-]{1,80}$"
            },
            "additionalProperties": {
              "$ref": "#/components/schemas/Asset"
            }
          },
          "blocks": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/Block"
            }
          },
          "api": {
            "type": "object",
            "properties": {
              "baseUrl": {
                "type": "string",
                "description": "Configuração opcional; nunca inclua tokens.",
                "maxLength": 2048
              },
              "path": {
                "type": "string",
                "description": "Caminho do editor, normalmente /banners",
                "maxLength": 200
              }
            }
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Na gravação, o servidor substitui pelo horário UTC atual."
          }
        },
        "description": "IDs e tipos são validados estritamente. Estilos opcionais recebem defaults; valores fora da faixa são limitados pelo BannerCore. Campos desconhecidos são descartados. Recomenda-se enviar todos os campos, como no exemplo."
      },
      "Banner": {
        "type": "object",
        "required": [
          "schema",
          "version",
          "id",
          "title",
          "preset",
          "background",
          "assets",
          "blocks",
          "api",
          "updatedAt"
        ],
        "properties": {
          "schema": {
            "const": "banerlab"
          },
          "version": {
            "type": "integer",
            "const": 2
          },
          "id": {
            "type": "string",
            "pattern": "^(?!(__proto__|constructor|prototype)$)[A-Za-z0-9_-]{1,80}$"
          },
          "title": {
            "type": "string",
            "description": "Título do projeto",
            "maxLength": 160
          },
          "preset": {
            "type": "string",
            "enum": [
              "60x90",
              "80x120",
              "90x120",
              "100x150"
            ]
          },
          "background": {
            "type": "object",
            "properties": {
              "color": {
                "type": "string",
                "pattern": "^#[A-Fa-f0-9]{6}$"
              },
              "assetId": {
                "type": "string",
                "description": "Vazio ou chave existente em assets",
                "maxLength": 80
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "fit": {
                "type": "string",
                "enum": [
                  "contain",
                  "cover",
